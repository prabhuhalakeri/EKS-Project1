pipeline {
       agent any
    environment {
        registry = "764906773278.dkr.ecr.ap-south-1.amazonaws.com/planmytravel"
    }
   
    stages {
        stage('Cloning Git') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: '*/feature']], doGenerateSubmoduleConfigurations: false, extensions: [], submoduleCfg: [], userRemoteConfigs: [[credentialsId: 'prabhuhalakeri', url: 'https://github.com/prabhuhalakeri/EKS-Project1.git']]])     
            }
        }
      stage ('Build') {
          steps {
            sh 'docker build -t planmytravel:latest .'           
            }
      }
    // Building Docker images
    stage('Building image') {
      steps{
        script {
          dockerImage = docker.build registry 
        }
      }
    }
   
    // Uploading Docker images into AWS ECR
    stage('Pushing to ECR') {
     steps{  
         script {
                sh 'aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 764906773278.dkr.ecr.ap-south-1.amazonaws.com'
                sh 'docker push 764906773278.dkr.ecr.ap-south-1.amazonaws.com/planmytravel:latest'
         }
        }
      }

       stage('K8S Deploy') {
        steps{   
            script {
                withKubeConfig([credentialsId: 'K8S', serverUrl: '']) {
                sh ('kubectl apply -f eks-deploy-k8s.yaml')
                }
            }
        }
       }
    }
}